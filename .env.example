# =============================================================================
# Italir Pothe NestJS backend - LOCAL DEVELOPMENT
# Copy to .env and replace placeholder values. Never commit the real .env.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Admin web origins allowed by CORS. Add your LAN URL when required.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

PUBLIC_API_BASE_URL=https://your-api-domain.com

CERTIFICATE_PUBLIC_VERIFY_BASE_URL=https://your-api-domain.com/certificates/public/verify

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_NAME=italir_pothe
# Local development only. Keep false in production and use migrations.
TYPEORM_SYNC=true

# Authentication
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d

# Local OTP testing
EMAIL_BYPASS=true
SMS_BYPASS=true

# OTP abuse protection (rolling windows)
TRUST_PROXY_HOPS=1
OTP_RATE_LIMIT_HASH_SECRET=replace-with-a-long-random-secret
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_IDENTIFIER_HOURLY_LIMIT=5
OTP_IDENTIFIER_DAILY_LIMIT=10
OTP_IP_HOURLY_SEND_LIMIT=20
OTP_IP_DAILY_SEND_LIMIT=100
OTP_IP_HOURLY_VERIFY_LIMIT=60
OTP_IP_DAILY_VERIFY_LIMIT=200

# ZeptoMail REST API and signed bounce/complaint webhooks
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_TOKEN=replace-with-your-zeptomail-send-token
ZEPTOMAIL_FROM_EMAIL=replace-with-your-existing-sender-address
ZEPTOMAIL_FROM_NAME=Italir Pothe
ZEPTOMAIL_WEBHOOK_SECRET=replace-with-the-agent-authentication-key

# AWS S3 / Zoho Mail
# AWS_S3_BUCKET is required by the current FilesModule during startup.
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=replace-with-your-s3-bucket-name
# Optional CDN or public bucket URL, without a trailing slash.
AWS_S3_PUBLIC_BASE_URL=

# HLS video worker. Debian installs these paths through the ffmpeg package.
VIDEO_TRANSCODING_ENABLED=true
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# Zoho Mail SMTP for OTP email delivery.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURE=false
ZOHO_SMTP_USER=replace-with-your-zoho-mail-address
ZOHO_SMTP_PASS=replace-with-your-zoho-mail-app-password
ZOHO_FROM_EMAIL=replace-with-your-zoho-mail-address

# Firebase push notifications. Leave all three blank to disable Firebase locally.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep escaped newlines exactly as \n when stored in one .env line.
FIREBASE_PRIVATE_KEY=

# Apple PushKit provider credentials for terminated/background iOS calls.
# The APNs key must have Push Notifications enabled. Keep escaped newlines as
# \n when the .p8 contents are stored on one environment-variable line.
APPLE_APNS_KEY_ID=
APPLE_APNS_TEAM_ID=
APPLE_APNS_PRIVATE_KEY=
APPLE_APNS_BUNDLE_ID=com.shafacode.italirpothe
# Production deployments must keep this false. Use true only for development
# builds signed with the development aps-environment entitlement.
APPLE_APNS_USE_SANDBOX=false

# Social authentication. GOOGLE_CLIENT_ID is the Web OAuth client ID used as
# the ID-token audience by both Flutter and this backend.
GOOGLE_CLIENT_ID=
# Native iOS Sign in with Apple token audience (the Runner bundle ID).
APPLE_CLIENT_ID=com.shafacode.italirpothe
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Keep aligned with the Graph API version enabled for the Meta app.
FACEBOOK_GRAPH_API_VERSION=v23.0

# Gemini Live native audio. API key is backend-only.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LEVEL_TEST_MODEL=gemini-3.6-flash
GEMINI_SESSION_SUMMARY_INTERVAL_SECONDS=300
GEMINI_SESSION_SUMMARY_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_VAD_PREFIX_PADDING_MS=300
GEMINI_VAD_SILENCE_DURATION_MS=900

# Legacy Pipecat service remains used by text chat and recorded level-test APIs.
PIPECAT_SERVICE_URL=http://127.0.0.1:8080
# Must exactly match pipecat-backend/.env.
PIPECAT_INTERNAL_API_KEY=replace-with-the-same-long-random-secret
PIPECAT_REQUEST_TIMEOUT_MS=60000
AI_TUTOR_LEVEL_TEST_MAX_ATTEMPTS=3
AI_TUTOR_LEVEL_TEST_MIN_SPEAKING_QUESTIONS=4
AI_TUTOR_LEVEL_TEST_MAX_SPEAKING_QUESTIONS=6

# Agora webinar/call token generation
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRE_SECONDS=3600

# Payments/demo configuration
PAYMENTS_DEMO_MODE=true
DEMO_EUR_TO_BDT_RATE=130
GOOGLE_PLAY_DEMO_PRODUCT_PREFIX=italir_pothe

# Important-verbs synchronization. Disabled for a normal local startup.
IMPORTANT_VERBS_SYNC_ON_STARTUP=false
IMPORTANT_VERBS_MONTHLY_SYNC_ENABLED=false
IMPORTANT_VERBS_IMPORT_ALL=false
IMPORTANT_VERBS_MAX_VERBS=100
IMPORTANT_VERBS_SOURCE_VERSION=v1
IMPORTANT_VERBS_KAIKKI_SOURCE=
IMPORTANT_VERBS_UNIMORPH_SOURCE=
IMPORTANT_VERBS_LEMMA_FILE=
IMPORTANT_VERBS_LEMMAS=
IMPORTANT_VERBS_TATOEBA_ENABLED=false
IMPORTANT_VERBS_TATOEBA_ENDPOINT=https://tatoeba.org/en/api_v0/search
IMPORTANT_VERBS_TATOEBA_MAX_REQUESTS=500
IMPORTANT_VERBS_TATOEBA_REQUEST_DELAY_MS=150
IMPORTANT_VERBS_TATOEBA_TIMEOUT_MS=15000

# Optional LibreTranslate service used by important-verbs imports.
LIBRETRANSLATE_ENABLED=false
LIBRETRANSLATE_ENDPOINT=http://127.0.0.1:5001
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_SOURCE_LANGUAGE=en
LIBRETRANSLATE_TARGET_LANGUAGE=bn
LIBRETRANSLATE_PIPELINE_VERSION=v1
LIBRETRANSLATE_BATCH_SIZE=20
LIBRETRANSLATE_BATCH_MAX_CHARACTERS=8000
LIBRETRANSLATE_REQUEST_DELAY_MS=100
LIBRETRANSLATE_TIMEOUT_MS=30000
LIBRETRANSLATE_MAX_RETRIES=3
